\@writefile{lot}{\contentsline {table}{\numberline {4.4}{\ignorespaces Fit by maturity at the parameters of Table \ref {tab:rhfit}. The last two columns are the share of the objective $\Phi $ contributed by each maturity, and that maturity's share of the gap $\Phi (H{=}0.107)-\Phi (H{=}0.49)$. In volatility the error grows with maturity; weighted by the spread the order reverses, and the shortest maturity carries both a quarter of the objective and well over half of the preference for the smooth kernel.}}{136}{table.caption.47}\protected@file@percent }
\newlabel{tab:rhpermat}{{4.4}{136}{Fit by maturity at the parameters of Table \ref {tab:rhfit}. The last two columns are the share of the objective $\Phi $ contributed by each maturity, and that maturity's share of the gap $\Phi (\Hurst {=}0.107)-\Phi (\Hurst {=}0.49)$. In volatility the error grows with maturity; weighted by the spread the order reverses, and the shortest maturity carries both a quarter of the objective and well over half of the preference for the smooth kernel}{table.caption.47}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.5}{\ignorespaces The objective profiled in $H$. Entries marked $^{*}$ sit on the upper bound of $\theta $. The profile is strictly monotone: every rougher kernel fits strictly worse.}}{137}{table.caption.48}\protected@file@percent }
\newlabel{tab:rhprofile}{{4.5}{137}{The objective profiled in $\Hurst $. Entries marked $^{*}$ sit on the upper bound of $\theta $. The profile is strictly monotone: every rougher kernel fits strictly worse}{table.caption.48}{}}
